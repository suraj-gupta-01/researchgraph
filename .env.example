# Copy to .env and fill in. Never commit the real .env.

POSTGRES_USER=researchgraph
POSTGRES_PASSWORD=change_me
POSTGRES_DB=researchgraph
POSTGRES_PORT=5432

MONGO_USER=researchgraph
MONGO_PASSWORD=change_me
MONGO_DB=researchgraph
MONGO_PORT=27017

BACKEND_PORT=8000

# Semantic Scholar: request a key early (see PRD Section 11 risks) — the
# unauthenticated tier's rate limit will bottleneck ingestion otherwise.
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex asks for a contact email in the "polite pool" header — no key
# needed, but this raises your effective rate limit.
OPENALEX_MAILTO=you@example.com

# Frontend (dashboard). VITE_API_URL is the address the BROWSER uses for the API.
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
# Browser origins the API accepts (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sign-in (G7). Comma-separated username:password:role, role one of
# viewer | analyst | admin. Passwords may be pbkdf2 hashes:
#   docker compose exec backend python -m app.auth hash '<password>'
# The values below are demo accounts; change them before sharing the stack.
AUTH_ENABLED=true
AUTH_USERS=viewer:viewer-demo:viewer,analyst:analyst-demo:analyst,admin:admin-demo:admin
# Signs session cookies. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Left empty, a random key is used and every backend restart signs users out.
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# true when served over HTTPS
COOKIE_SECURE=false
